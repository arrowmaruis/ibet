# ---------------------------------------------------------------------------
# Choix du provider : flashscore | thesportsdb | football-data | api-football
# flashscore et thesportsdb fonctionnent sans clé -> defaut flashscore
# ---------------------------------------------------------------------------
PROVIDER=flashscore

# Flashscore (flashscore.fr) : aucune clé, couverture mondiale, +/- 7 jours
# autour d'aujourd'hui. Lit le flux interne du site : usage personnel seulement.
# Le jeton ci-dessous est constant ; ne le renseigner que s'il venait a changer
# (symptome : "flux vide"). Il se releve dans l'en-tete x-fsign des requetes
# emises par https://www.flashscore.fr/ (onglet Reseau du navigateur).
FLASHSCORE_FSIGN=

# TheSportsDB : gratuit, cle de test publique "123" (aucune inscription)
# https://www.thesportsdb.com/api.php
THESPORTSDB_KEY=123

# football-data.org : gratuit, non commercial, 10 req/min, 12 competitions
# https://www.football-data.org/client/register
FOOTBALL_DATA_KEY=

# API-Football (api-sports.io) : gratuit 100 req/jour, couverture tres large
# https://dashboard.api-football.com/register
API_FOOTBALL_KEY=

# Fuseau horaire d'affichage des heures de coup d'envoi
TIMEZONE=Europe/Paris

# Duree de vie du cache local en secondes (3600 = 1h)
CACHE_TTL=3600

# Poids des 14 criteres de decision, pour surcharger les valeurs mesurees.
# Format : critere=valeur, separes par des virgules, entre 0 et 1.
# Les valeurs par defaut sortent d'une mesure sur 80 matchs (voir README) :
# style=1, xg=0.25, fatigue=1, tous les autres a 0.
# Quatre criteres (effectif, arbitre, motivation, enjeu) ne sont pas mesurables
# a posteriori et restent donc a zero ; cette variable permet de les essayer.
# Exemple : POIDS_CONTEXTE=effectif=0.5,arbitre=1
POIDS_CONTEXTE=

# Bundle de certificats (antivirus/proxy HTTPS) - genere par `python setup_ca.py`
CA_BUNDLE=

# the-odds-api.com : cotes agregees de plusieurs operateurs (dont 1xBet), tous
# marches, JSON documente. Gratuit jusqu'a 500 requetes par mois, ce qui suffit
# largement : une requete couvre une journee entiere de football, et le cache la
# garde un quart d'heure.
#
# Sans cette cle, tout continue de fonctionner : --valeur retombe sur le seul
# 1X2 releve chez BetExplorer, et les autres marches restent a saisir a la main
# (--cote). C'est une configuration, pas une panne.
#
# Inscription : https://the-odds-api.com/
ODDS_API_KEY=
